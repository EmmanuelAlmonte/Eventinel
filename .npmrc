# Required: package-lock.json is resolved with this setting. Without it npm
# re-resolves peers that no longer match React 19: @testing-library/react@14
# and its @types/react-dom@18 both want React 18. They are pulled in by
# @nostr-dev-kit/mobile -> @nostr-dev-kit/react.
# This also hides new peer conflicts, so check `npm ls` after dependency changes.
# Remove once @nostr-dev-kit/react stops depending on React 18-only packages.
legacy-peer-deps=true
