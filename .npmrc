# Required: package-lock.json is resolved with this setting. Without it npm
# rewrites the lockfile to satisfy React 18 peers: @testing-library/react@14
# wants react and react-dom 18, and its @types/react-dom@18 wants
# @types/react 18. Both come from @nostr-dev-kit/mobile -> @nostr-dev-kit/react.
# Peer checks are off, so run `npm ls --all` after dependency changes. Expected
# non-optional problems today: invalid react and @types/react (the React 18
# peers above), unmet react-dom@^18, and unmet @testing-library/jest-native
# (a peer of @rneui/base). Anything else is new.
# Remove once @nostr-dev-kit/react stops depending on React 18-only packages.
legacy-peer-deps=true
